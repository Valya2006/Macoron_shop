doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Вход в аккаунт
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    link(rel="stylesheet" href="./style/views-style.css")
    link(rel="stylesheet" href="./style/style.css")
  body
    .login-conteiner
      form.form-conteiner(action='/registration' method='POST')
        h1.h1-login Регистрация
        
        .form-group
          .form-group-flex-row
            .form-group-flex
              .label-input
                label(for='name') ФИО
                input(type='name' id='name' name='name' placeholder='Укажите ваше ФИО' required autocomplete="username")
            
              .label-input
                label(for='password') Придумайте пароль
                input(type='password' id='password' name='password' placeholder='Придумайте пароль' required autocomplete="password")
            
            .form-group-flex
              .label-input
                label(for='phone') Tелефон
                input(type='phone' id='phone' name='phone' placeholder='+7___-___-__-__' required autocomplete="phone")
              
              .label-input
                label(for='email') Email
                input(type='email' id='email' name='email' placeholder='example@gmail.com' required autocomplete="password")

          .errors-container(style=errors && errors.length ? 'display: flex' : 'display: none')
            each error in errors
              p #{error}
          
          .button-container
            button.pink-button(type='submit') Зарегистрироваться
            button.blue-button(type='button' href='/registration')
              a(href='/login') Войти